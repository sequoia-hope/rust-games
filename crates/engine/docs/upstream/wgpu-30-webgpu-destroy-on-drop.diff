+// DESTROY ON DROP (bevy-patches): the crates.io release never calls
+// `destroy()` on a buffer or texture; it leaves each to the JS garbage
+// collector, which sees only a small wrapper, not the GPU memory behind
+// it (Safari may not collect it for a long time). Here a buffer or texture
+// is destroyed when the last thing that can still use it lets go, as
+// wgpu-core does natively: every clone of its handle, the views of a
+// texture, the bind groups that bind it, and the encoders, passes, bundles
+// and command buffers that record it, until the command buffer is
+// submitted (WebGPU frees the memory once the submitted work is done).
+
+/// A buffer's or texture's life: destroyed when the last `Rc` goes.
+#[derive(Debug)]
+enum Life {
+    Buffer(webgpu_sys::GpuBuffer),
+    Texture(webgpu_sys::GpuTexture),
+    /// A canvas's current texture: the browser's, never destroyed here.
+    Borrowed,
+}
+
+impl Drop for Life {
+    fn drop(&mut self) {
+        match self {
+            Life::Buffer(buffer) => buffer.destroy(),
+            Life::Texture(texture) => texture.destroy(),
+            Life::Borrowed => {}
+        }
+    }
+}
+
+/// What something that can still use buffers or textures keeps alive.
+#[derive(Debug, Clone)]
+enum Keep {
+    One(Rc<Life>),
+    Many(Rc<[Keep]>),
+}
+
+impl Keep {
+    fn same(&self, other: &Keep) -> bool {
+        match (self, other) {
+            (Keep::One(a), Keep::One(b)) => Rc::ptr_eq(a, b),
+            (Keep::Many(a), Keep::Many(b)) => Rc::ptr_eq(a, b),
+            _ => false,
+        }
+    }
+}
+
+/// What an encoder and its passes, or a bundle encoder, have recorded.
+#[derive(Debug, Clone, Default)]
+struct Kept(Rc<RefCell<Vec<Keep>>>);
+
+impl Kept {
+    fn push(&self, keep: Keep) {
+        let mut list = self.0.borrow_mut();
+        // Draws set the same buffers and bind groups over and over.
+        if !list.last().is_some_and(|last| last.same(&keep)) {
+            list.push(keep);
+        }
+    }
+
+    fn buffer(&self, buffer: &dispatch::DispatchBuffer) {
+        self.push(Keep::One(buffer.as_webgpu().life.clone()));
+    }
+
+    fn texture(&self, texture: &dispatch::DispatchTexture) {
+        self.push(Keep::One(texture.as_webgpu().life.clone()));
+    }
+
+    fn view(&self, view: &dispatch::DispatchTextureView) {
+        self.push(view.as_webgpu().keep.clone());
+    }
+
+    fn bind_group(&self, bind_group: &dispatch::DispatchBindGroup) {
+        self.push(Keep::Many(bind_group.as_webgpu().keep.clone()));
+    }
+
+    fn take(&self) -> Vec<Keep> {
+        core::mem::take(&mut *self.0.borrow_mut())
+    }
+}
